# Genuine local neural ASR runtime
LOCAL_GHANA_ASR_URL=http://127.0.0.1:8765
LOCAL_GHANA_ASR_MODEL=your-verified-local-asr-model
LOCAL_GHANA_ASR_TIMEOUT_MS=4500
LOCAL_GHANA_ASR_TOKEN=
LOCAL_ASR_MODEL_PATH=C:\models\your-ghanaspeech-model
LOCAL_ASR_MODEL_LABEL=your-verified-ghana-asr
LOCAL_ASR_DEVICE=cpu
LOCAL_ASR_COMPUTE_TYPE=int8
LOCAL_ASR_PORT=8765

# Genuine local neural Piper/VITS runtime
PIPER_TTS_URL=http://127.0.0.1:8766
PIPER_MODEL=your-verified-local-piper-voice
PIPER_DATA_DIR=C:\models\piper
PIPER_TTS_TIMEOUT_MS=5000
PIPER_TTS_TOKEN=
PIPER_PORT=8766

# Explicitly disabled by default. Turn on only for development experiments.
ALLOW_EXPERIMENTAL_FORMANT_TTS=false