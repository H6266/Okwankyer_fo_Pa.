{
  "name": "okwankyer-fo-pa",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build --outDir dist/client && esbuild src/serverApp.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node server.ts",
    "test": "vitest run --testTimeout=15000",
    "test:voicexml": "vitest run tests/voicexmlSnapshots.test.ts",
    "test:e2e": "vitest run tests/ivrFullFlowIntegration.test.ts",
    "shadow:summary": "tsx scripts/summarize_shadow_disagreements.ts",
    "eval:transcripts": "tsx scripts/run_eval_transcripts.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint DATA_LICENSE_GATE.ts scripts/validate_datasets.ts scripts/run_ai_benchmark.ts scripts/grade_ai.ts",
    "check:copy": "node scripts/check-copy.mjs",
    "security:audit": "tsx scripts/security_audit.ts",
    "ai:security-audit": "tsx scripts/security_audit.ts",
    "ai:eval": "tsx scripts/run_ai_eval.ts",
    "ai:benchmark": "tsx scripts/run_ai_benchmark.ts",
    "ai:offline-test": "vitest run tests/offlineAIEngine.test.ts",
    "ai:data:validate": "tsx scripts/validate_datasets.ts",
    "ai:data:prepare": "python3 training/create_splits.py",
    "ai:train:nlu": "python3 training/train_nlu.py",
    "ai:train:asr": "tsx scripts/train_local_asr.ts",
    "ai:train:tts": "tsx scripts/train_local_tts.ts",
    "ai:grade": "tsx scripts/grade_ai.ts",
    "ai:speech:health": "tsx scripts/check_local_speech.ts",
    "ai:asr:eval": "tsx scripts/run_asr_eval.ts",
    "predeploy": "npm run check:copy && npm run typecheck && npm run test"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "esbuild": "^0.28.2",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "google-tts-api": "^2.0.2",
    "helmet": "^8.3.0",
    "jszip": "^3.10.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.4",
    "vite": "^8.3.0",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^4.17.21",
    "@types/jszip": "^3.4.1",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.18.2",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-plugin-security": "^4.2.0",
    "supertest": "^7.3.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "5.8.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.3"
  }
}
