{
  "name": "Ɔkwankyerɛfo Pa - Voice Accessibility Layer",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "postCreateCommand": "npm install --legacy-peer-deps",
  "postStartCommand": "bash -lc 'npm run dev > /tmp/okwankyer-fo-pa-dev.log 2>&1 &'",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "Okwankyerɛfo Pa",
      "onAutoForward": "openBrowser",
      "visibility": "public"
    }
  },
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  }
}
